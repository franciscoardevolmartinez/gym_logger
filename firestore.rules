rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /globalExercises/{exerciseId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /exerciseSuggestions/{suggestionId} {
      allow create: if signedIn() && request.resource.data.suggestedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /{document=**} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
